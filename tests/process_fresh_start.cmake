if(NOT DEFINED SIMULATOR)
 message(FATAL_ERROR "Simulator path is required")
endif()
set(test_dir "${CMAKE_CURRENT_BINARY_DIR}/fresh-start-test")
file(MAKE_DIRECTORY "${test_dir}")
set(profile "${test_dir}/device-profile.json")
set(legacy "${test_dir}/current-game.json")
set(old_match "Legacy match data must remain untouched")
file(WRITE "${legacy}" "${old_match}")
file(WRITE "${profile}" "{\"version\":1,\"id\":\"0123456789abcdef0123456789abcdef\",\"name\":\"FRESHNAME\"}")
execute_process(COMMAND "${SIMULATOR}" --smoke-test --profile-file "${profile}" WORKING_DIRECTORY "${test_dir}" RESULT_VARIABLE first OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT first EQUAL 0)
 message(FATAL_ERROR "Initial process failed: ${output} ${errors}")
endif()
file(SHA256 "${profile}" profile_before)
execute_process(COMMAND "${SIMULATOR}" --startup-test --profile-file "${profile}" WORKING_DIRECTORY "${test_dir}" RESULT_VARIABLE second OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT second EQUAL 0 OR NOT output MATCHES "Smoke profile=FRESHNAME")
 message(FATAL_ERROR "Fresh startup failed: ${output} ${errors}")
endif()
file(SHA256 "${profile}" profile_after)
file(READ "${legacy}" remaining_match)
if(NOT profile_before STREQUAL profile_after OR NOT remaining_match STREQUAL old_match)
 message(FATAL_ERROR "Restart must retain the identity and leave old match files untouched")
endif()
message(STATUS "Second process starts without a match, retaining the device profile")
